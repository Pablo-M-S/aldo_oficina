# Banco de dados
DATABASE_URL="postgresql://oficina:oficina@localhost:5432/oficina_db?schema=public"

# Autenticação
JWT_SECRET="troque-este-valor-por-um-segredo-forte-gerado-aleatoriamente"
JWT_EXPIRES_IN="8h"

# Aplicação
PORT=3000
NODE_ENV=development

# CORS — domínios autorizados a consumir a API, separados por vírgula
CORS_ORIGIN="http://localhost:5173"
